# MindQ Frontend Environment Variables
# Copy this file to .env and adjust values as needed.

# API Base URL
#
# Option 1: Relative path (uses Vite dev proxy — localhost development)
#   VITE_API_BASE_URL=/api/v1
#   The Vite proxy in vite.config.ts forwards /api/* to http://localhost:8080
#   No CORS issues since requests are same-origin.
#
# Option 2: Direct backend URL (LAN development)
#   VITE_API_BASE_URL=http://192.168.x.x:8080/api/v1
#   Frontend talks directly to the backend. Backend CORS must allow the frontend origin.
#   Use this when accessing the frontend from another device on your LAN.
#
VITE_API_BASE_URL=/api/v1

# Razorpay (frontend only needs the key ID, never the secret)
# Get from Razorpay Dashboard > Settings > API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_xxxx
