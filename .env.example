# ==========================================
# MindQ - Environment Configuration
# ==========================================
# Copy this file to .env and configure your local settings.
# NEVER commit .env to version control.

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindq_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Server Configuration
SERVER_PORT=8080

# JWT Configuration
# Must be at least 32 characters.
# Generate a strong random secret for real environments.
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Groq AI API
# Get your API key from:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# Email (SMTP) Configuration
# Set MAIL_ENABLED=true to send real emails via SMTP.
# For Gmail: use an App Password (not your real password).
# https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=MindQ <your_gmail_address@gmail.com>

# CORS — comma-separated list of allowed frontend origins
# Add your LAN IP(s) here for mobile/other-device access.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000