# ==========================================
# MindQ - Production Environment Configuration
# ==========================================
# This file documents production-safe defaults.
# NEVER commit actual .env.production to version control.
#
# Copy to your production environment and fill in real values.

# Database Configuration (MySQL)
DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=mindq_db
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_production_db_password

# Backend Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Groq AI API
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# Email Configuration (Production SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_production_email@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM=your_production_email@gmail.com
MAIL_FROM_NAME=MindQ

# CORS -- your production frontend domain(s)
CORS_ALLOWED_ORIGINS=https://mindq-swart.vercel.app

# ==========================================
# SECURITY: These MUST remain false in production
# ==========================================
OTP_ENABLED=true

# OTP Bypass (TEMPORARY - remove when email delivery is fixed)
# -----------------------------------------------
# Set to true to bypass OTP verification for testing.
# Default: false (bypass OFF)
# When true: bypass is ON for all OTP flows (REGISTRATION, LOGIN, PASSWORD_RESET)
# When false or absent: normal OTP flow
#
# USE CASES:
#   LOCAL DEVELOPMENT: OTP_BYPASS_ENABLED=true
#   RAILWAY TEMPORARY TEST: OTP_BYPASS_ENABLED=true
#   NORMAL PRODUCTION: OTP_BYPASS_ENABLED=false (or remove this line)
#
# WARNING: Remove this or set to false when email delivery is fixed.
OTP_BYPASS_ENABLED=false
