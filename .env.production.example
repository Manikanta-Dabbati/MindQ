# ============================================
# MindQ Production Environment Variables
# ============================================
# Copy this file to .env.production and fill in values
# DO NOT commit .env.production to version control

# Database
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_NAME=mindq_db
DB_USERNAME=mindq_user
DB_PASSWORD=your_secure_password_here

# JWT (MUST be at least 32 characters)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here

# AI Provider
GROQ_API_KEY=your_groq_api_key_here

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Hikari Connection Pool
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# Storage
STORAGE_FREE_LIMIT_BYTES=524288000
MAX_FILE_SIZE_BYTES=10485760

# Email (optional)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=MindQ <noreply@yourdomain.com>

# OTP
OTP_ENABLED=true

# Payment (optional)
RAZORPAY_ENABLED=false
RAZORPAY_KEY=rzp_test_your_key
RAZORPAY_SECRET=your_razorpay_secret

# Logging
SHOW_SQL=false
FORMAT_SQL=false
